  "dialects": {
    "liquid-handler": {
      "label": "PyLabRobot LiquidHandler (v0 API)",
      "robot": [
        "robot = LiquidHandler(backend={backend}(), deck=deck)"
      ],
      "setup": "await robot.setup()",
      "stop": "await robot.stop()",
      "deck": {
        "create": "deck = {deck}()",
        "carrier": "{var} = {factory}(name=\"{var}\")",
        "place": "{carrier}[{site}] = {res}",
        "assign": "deck.assign_child_resource({carrier}, rails={rails})",
        "adapt": "{adapter}.assign_child_resource({res})"
      },
      "trash": [],
      "trash96": [],
      "styles": {
        "channels": {
          "loop": [
            "for start in range(0, SAMPLES, {n}):",
            "    wells = lw[\"plate\"].get_all_items()[start:start + {n}]",
            "    use = list(range(len(wells)))"
          ],
          "pickup": "await {head}.pick_up_tips(next_tips(lw, {size}, len(wells)), use_channels=use)",
          "aspirate": "await {head}.aspirate({src}, vols={vols}, use_channels=use)",
          "dispense": "await {head}.dispense({dst}, vols={vols}, use_channels=use)",
          "discard": "await {head}.discard_tips(use_channels=use)",
          "vols": "[{volume}] * len(wells)",
          "irregular": {
            "vols": "per_well[start:start + len(wells)]"
          },
          "targets": {
            "plate": "wells",
            "reagent": "[lw[{reservoir}].get_item({k})] * len(wells)",
            "waste": "[lw[\"waste\"].get_item(0)] * len(wells)",
            "dest": "lw[\"dest\"].get_all_items()[start:start + len(wells)]"
          },
          "draw": {
            "source": "lw[{reservoir}].get_item({k})"
          },
          "dump": {
            "target": "lw[\"waste\"].get_item(0)"
          },
          "group": "start // {n}"
        },
        "plate": {
          "loop": [],
          "pickup": "await {head}.pick_up_tips96(next_rack(lw, {size}))",
          "aspirate": "await {head}.aspirate96({src}, volume={volume})",
          "dispense": "await {head}.dispense96({dst}, volume={volume})",
          "discard": "await {head}.discard_tips96()",
          "targets": {
            "plate": "lw[\"plate\"]",
            "reagent": "lw[{trough}]",
            "waste": "lw[\"waste\"]",
            "dest": "lw[\"dest\"]"
          },
          "draw": {
            "source": "lw[{trough}].get_item(0)"
          },
          "dump": {
            "target": "lw[\"waste\"].get_item(0)"
          },
          "group": "0"
        }
      },
      "put": [
        "async def put(robot, lw, res, to):",
