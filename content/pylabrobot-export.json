    "imports": [
      "set_tip_tracking(",
      "set_volume_tracking("
    ],
    "helpers": [
      "set_tip_tracking(True)",
      "set_volume_tracking(True)",
      "",
      "",
      "def pause(message):",
      "    \"\"\"Simulation: log what a person would do and carry on.\"\"\"",
      "    print(f\"@@plr-pause {message}\", flush=True)",
      "",
      "",
      "def skip_wait(seconds):",
      "    \"\"\"Simulation: log the wait instead of waiting.\"\"\"",
      "    print(f\"@@plr-wait {seconds}\", flush=True)",
      "",
      "",
      "TOLERANCE_UL = 0.01  # differential check (#124): most a tracker may differ from the planner's ledger",
      "",
      "",
      "def check_volumes(name, lw, expect):",
      "    \"\"\"Simulation: compare PyLabRobot's volume trackers with the planner's ledger after a step (#124).\"\"\"",
      "    plate_ul, dest_ul, vessels = expect",
      "    wrong = []",
      "    for key, ul in ((\"plate\", plate_ul), (\"dest\", dest_ul)):",
      "        if key not in lw:",
      "            continue",
      "        for well in lw[key].get_all_items()[:SAMPLES]:",
      "            got = well.tracker.get_used_volume()",
      "            if abs(got - ul) > TOLERANCE_UL:",
      "                wrong.append(f\"{key} {well.name}: PyLabRobot {got:.4f} ul, planner {ul} ul\")",
      "                break",
      "    for key, i, ul in vessels:",
      "        well = lw[key].get_item(i)",
      "        got = well.tracker.get_used_volume()",
      "        if abs(got - ul) > TOLERANCE_UL:",
      "            wrong.append(f\"{well.name}: PyLabRobot {got:.4f} ul, planner {ul} ul\")",
      "    if wrong:",
      "        print(f\"@@plr-mismatch {name} \" + \"; \".join(wrong), flush=True)",
      "        raise AssertionError(f\"{name}: PyLabRobot and the planner's ledger disagree: \" + \"; \".join(wrong))",
      "    print(f\"@@plr-checked {name}\", flush=True)",
      "",
      "",
      "async def run_step(name, fn, robot, lw, expect=None):",
      "    \"\"\"Simulation: report each protocol step as it starts and ends, and check its volumes against the ledger.\"\"\"",
      "    print(f\"@@plr-step-start {name}\", flush=True)",
      "    await fn(robot, lw)",
      "    if expect is not None:",
      "        check_volumes(name, lw, expect)",
      "    print(f\"@@plr-step-done {name}\", flush=True)",
      "",
      "",
      "async def device_ok(*args, **kwargs):",
      "    \"\"\"Simulation: a module command with no PyLabRobot simulator succeeds and is logged.\"\"\"",
      "    print(f\"@@plr-device {args}\", flush=True)",
      "    return \"\""
    ],
